# Increase brightness with Alt+Shift+Scroll Up
super + shift + button4
		~/Scripts/increase_brightness.sh

super + F8
		~/Scripts/increase_brightness.sh

# Decrease brightness with Alt+Shift+Scroll Down
super + shift + button5
		~/Scripts/decrease_brightness.sh

super + F7
		~/Scripts/decrease_brightness.sh

# Mute
super + F1
		pactl set-sink-volume @DEFAULT_SINK@ 0

# Launch flameshot for screen clipping
super + F6
		flameshot gui &

super + 6
		flameshot gui &

# Using touchpad on/off
super + F10
		~/Scripts/mouse_pad_off_on.sh

# Suspend / Sleep
super + F11
		systemctl suspend &

# Lock
super + l
		lock
